[Unit]
Description=Guará — painel do tablet (servidor)
After=graphical-session.target network-online.target
PartOf=graphical-session.target

[Service]
ExecStart=@PYTHON@ @SERVER@
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONUNBUFFERED=1
# Cada áudio do tablet roda numa thread; sem limite o glibc abria uma arena de 64 MB por thread
# e o servidor chegou a 14 GB de RAM com o Whisper.
Environment=MALLOC_ARENA_MAX=2
Restart=always
RestartSec=3
# Programas abertos pelo tablet (VS Code, Chrome…) não podem morrer quando o serviço reinicia.
KillMode=process

[Install]
WantedBy=graphical-session.target
